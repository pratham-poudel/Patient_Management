    <style>
      .carousercontainer{
        height:400 ;
        width:600;
      
      }
      .faq-item {
              border-bottom: 1px solid #ddd;
              padding: 10px 0;
          }
          .faq-item h3 {
              cursor: pointer;
              margin: 0;
              font-size: 1.2em;
              display: flex;
              justify-content: space-between;
              align-items: center;
          }
          .faq-item h3 svg {
              transition: transform 0.2s;
          }
          .faq-item.open h3 svg {
              transform: rotate(180deg);
          }
          .faq-answer {
              display: none;
              padding: 10px 0;
              color: #555;
          }
          .faq-item.open .faq-answer {
              display: block;
          }
      .footer-container {
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
          }

          .map-container {
              width: 100%;
              max-width: 600px; /* Adjust this to fit your design */
              height: 300px; /* Adjust this to fit your design */
              margin-top: 20px; /* Add some spacing above the map */
          }
          #loading-animation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: white; /* Or any background color you want */
    z-index: 9999;
}

/* Example CSS for a simple spinner */
.spinner {
    border: 4px solid rgba(0, 0, 0, 0.1);
    border-left-color: #000;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

