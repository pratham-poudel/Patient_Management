<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Day Sheet | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f7f9fc;
      color: #333;
    }

    .container {
      max-width: 1200px;
      width: 100%;
      padding: 20px;
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
    }

    .header h2 {
      font-size: 2rem;
      color: #007bff;
    }

    .form-group {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .form-group input {
      width: 48%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 1rem;
      margin-bottom: 10px;
    }

    .search-btn {
      width: 100%;
      padding: 12px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .results-container {
      display: none;
      margin-top: 30px;
    }

    .results-header {
      text-align: center;
      margin-bottom: 10px;
    }

    .results-table-wrapper {
      overflow-x: auto;
    }

    .results-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    .results-table th,
    .results-table td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: left;
    }

    .results-table th {
      background-color: #f4f4f4;
      font-weight: 600;
    }

    .total-expenditure {
      color: red;
    }

    .results-table .expenditure {
      background-color: #ffdddd;
      color: red;
    }

    .results-table .deposite {
      background-color: #e6ffed;
      color: #218838;
    }

    .collection-summary {
      display: grid;
      gap: 15px;
      margin-top: 30px;
      background-color: #f1f1f1;
      border-radius: 8px;
      padding: 20px;
    }

    .summary-item {
      display: flex;
      justify-content: space-between;
      padding: 10px;
      background-color: #fff;
      border-radius: 5px;
    }

    .summary-label {
      font-weight: 600;
      color: #444;
    }

    .summary-value {
      font-size: 1.1rem;
      font-weight: bold;
    }

    .net-collection .summary-value {
      color: #28a745;
    }

    .collection-breakdown {
      margin-top: 20px;
    }

    .collection-breakdown h4 {
      font-size: 1.2rem;
      color: #007bff;
      margin-bottom: 10px;
    }

    .type-collections-list {
      list-style: none;
      padding: 0;
    }

    .type-collections-list li {
      font-size: 1rem;
      padding: 8px 0;
      border-bottom: 1px solid #ddd;
    }

    /* Responsive styling */
    @media (max-width: 768px) {
      .form-group input {
        width: 100%;
      }

      .results-table th,
      .results-table td {
        padding: 10px;
        font-size: 0.9rem;
      }
    }

    @media (max-width: 576px) {
      .results-table-wrapper {
        width: 100%;
        overflow-x: auto;
      }

      .results-table th,
      .results-table td {
        padding: 8px;
      }
    }

    /* Print styling for 3-inch paper */
    @media print {

      body,
      .container {
        width: 3in;
        font-size: 10px;
        margin: 0;
        padding: 0;
        color: #000;
        background-color: #fff;
      }

      .header h2 {
        font-size: 1.2rem;
        color: #000;
      }

      .form-group,
      .search-btn {
        display: none;
      }

      .results-table th,
      .results-table td {
        font-size: 13px;
        color: #000;
        border: 1px solid #000;
      }

      .results-table th {
        background-color: #f0f0f0;
      }

      .collection-summary {
        font-size: 0.8rem;
        display: block;
        margin: 0;
        padding: 0;
        border-collapse: collapse;
      }

      .summary-item,
      .type-collections-list li {
        color: #000;
        background-color: #fff;
        padding: 5px;
        border: 1px solid #000;
        border-top: none;
        /* Remove top border for seamless integration */
      }

      .type-collections-list {
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .summary-item:first-child {
        border-top: 1px solid #000;
        /* Only first item has top border */
      }

      .collection-breakdown h4 {
        font-size: 1rem;
        margin: 5px 0;
      }


      @page {
        margin: 0;
      }
  </style>
</head>

<body>

  <div class="container">
    <div class="header">
      <h2>Check Day Sheet</h2>
    </div>

    <div class="form-group">
      <input type="datetime-local" id="startDateTime" placeholder="Start Date and Time" required>
      <input type="datetime-local" id="endDateTime" placeholder="End Date and Time" required>
    </div>

    <button class="search-btn" id="searchBtn">Search</button>
    <button class="search-btn" id="lastDepositeBtn" style="margin-top:10px;background-color:#28a745;">Check from Last
      Deposite</button>

    <!-- Results Container -->
    <div class="results-container" id="resultsContainer">
      <div class="results-header">
        <h3>Results for <span id="dateRange"></span></h3>
      </div>
      <div class="total-collection" id="totalCollection"></div>
      <div class="results-table-wrapper">
        <table class="results-table" id="resultsTable">
          <thead>
            <tr>
              <th>Type</th>
              <th>Customer</th>
              <th>Total</th>
              <th>Details</th>
              <th>Date & Time (NPT)</th>
            </tr>
          </thead>
          <tbody id="resultsBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    // Function to convert UTC time to Nepali Time (NPT = UTC+5:45)
    function convertToNepaliTime(utcDateString) {
      const date = new Date(utcDateString);
      // Add 5 hours and 45 minutes for NPT
      const nptTime = new Date(date.getTime() + (5 * 60 + 45) * 60 * 1000);
      
      // Format: YYYY-MM-DD HH:MM:SS
      const year = nptTime.getUTCFullYear();
      const month = String(nptTime.getUTCMonth() + 1).padStart(2, '0');
      const day = String(nptTime.getUTCDate()).padStart(2, '0');
      const hours = String(nptTime.getUTCHours()).padStart(2, '0');
      const minutes = String(nptTime.getUTCMinutes()).padStart(2, '0');
      const seconds = String(nptTime.getUTCSeconds()).padStart(2, '0');
      
      return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
    }

    document.getElementById('searchBtn').addEventListener('click', async function () {
      const startDateTime = new Date(document.getElementById('startDateTime').value).toISOString();
      const endDateTime = new Date(document.getElementById('endDateTime').value).toISOString();
      const resultsContainer = document.getElementById('resultsContainer');
      const resultsBody = document.getElementById('resultsBody');
      const totalCollectionEl = document.getElementById('totalCollection');
      const dateRangeEl = document.getElementById('dateRange');

      if (!startDateTime || !endDateTime) {
        alert("Please select both start and end dates with times.");
        return;
      }

      resultsBody.innerHTML = '';
      totalCollectionEl.innerHTML = '';
      resultsContainer.style.display = 'none';

      try {
        const response = await fetch(`/api/day-sheet?startDateTime=${startDateTime}&endDateTime=${endDateTime}`);
        const data = await response.json();

        if (data.success) {
          const { invoices, totalRevenue, totalExpenditure, netCollection, typeCollections } = data;

          if (invoices.length > 0) {
            dateRangeEl.textContent = `${new Date(startDateTime).toLocaleString()} to ${new Date(endDateTime).toLocaleString()}`;
            resultsContainer.style.display = 'block';

            invoices.reverse().forEach(invoice => {
              const row = document.createElement('tr');
              if (invoice.type === 'Expenditure') {
                row.classList.add('expenditure');
              } else if (invoice.type === 'Deposite') {
                row.classList.add('deposite');
              } else {
                row.classList.add('revenue');
              }

              const nepaliTime = convertToNepaliTime(invoice.createdAt);

              row.innerHTML = `
            <td>${invoice.type}</td>
            <td>${invoice.customer.name}</td>
            <td>${invoice.totalPrice} NPR</td>
            <td><a href="/printinvoice/${invoice._id}">Show Details</a></td>
            <td>${nepaliTime}</td>
          `;

              resultsBody.appendChild(row);
            });

            totalCollectionEl.innerHTML = `
        <div class="collection-summary">
  <div class="summary-item">
    <span class="summary-label">Total Revenue:</span>
    <span class="summary-value">${totalRevenue} NPR</span>
  </div>
  <div class="summary-item">
    <span class="summary-label">Total Expenditure:</span>
    <span class="summary-value">${totalExpenditure} NPR</span>
  </div>
  <div class="summary-item net-collection">
    <span class="summary-label">Net Collection:</span>
    <span class="summary-value">${netCollection} NPR</span>
  </div>
  <div class="collection-breakdown">
    <h4>Type Collections</h4>
    <ul class="type-collections-list">
      <li>X-ray: ${typeCollections.Xray} NPR</li>
      <li>ECG: ${typeCollections.Ecg} NPR</li>
      <li>Lab: ${typeCollections.Lab} NPR</li>
      <li>USG: ${typeCollections.Usg} NPR</li>
      <li>Pharmacy: ${typeCollections.Pharmacy} NPR</li>
      <li>Invoice: ${typeCollections.Invoice} NPR</li>
    </ul>
  </div>
</div>
        `;
          } else {
            alert("No invoices or expenditures found for this date range.");
          }
        }
      } catch (error) {
        console.error("Error fetching data:", error);
      }
    });

    document.getElementById('lastDepositeBtn').addEventListener('click', async function () {
      const endDateInput = document.getElementById('endDateTime').value;
      let endDateTimeObj;
      if (!endDateInput) {
        // If not provided, use current time
        endDateTimeObj = new Date();
      } else {
        endDateTimeObj = new Date(endDateInput);
        if (isNaN(endDateTimeObj.getTime())) {
          alert("Invalid end date and time.");
          return;
        }
      }
      const endDateTime = endDateTimeObj.toISOString();
      const resultsContainer = document.getElementById('resultsContainer');
      const resultsBody = document.getElementById('resultsBody');
      const totalCollectionEl = document.getElementById('totalCollection');
      const dateRangeEl = document.getElementById('dateRange');

      resultsBody.innerHTML = '';
      totalCollectionEl.innerHTML = '';
      resultsContainer.style.display = 'none';

      try {
        const response = await fetch(`/api/day-sheet-from-last-deposite?endDateTime=${endDateTime}`);
        const data = await response.json();

        if (data.success) {
          const { invoices, totalRevenue, totalExpenditure, netCollection, typeCollections, fromDate } = data;

          if (invoices.length > 0) {
            dateRangeEl.textContent = `${fromDate ? new Date(fromDate).toLocaleString() : 'Last Deposite'} to ${new Date(endDateTime).toLocaleString()}`;
            resultsContainer.style.display = 'block';

            invoices.reverse().forEach(invoice => {
              const row = document.createElement('tr');
              if (invoice.type === 'Expenditure') {
                row.classList.add('expenditure');
              } else if (invoice.type === 'Deposite') {
                row.classList.add('deposite');
              } else {
                row.classList.add('revenue');
              }

              const nepaliTime = convertToNepaliTime(invoice.createdAt);

              row.innerHTML = `
            <td>${invoice.type}</td>
            <td>${invoice.customer.name}</td>
            <td>${invoice.totalPrice} NPR</td>
            <td><a href="/printinvoice/${invoice._id}">Show Details</a></td>
            <td>${nepaliTime}</td>
          `;

              resultsBody.appendChild(row);
            });

            totalCollectionEl.innerHTML = `
        <div class="collection-summary">
  <div class="summary-item">
    <span class="summary-label">Total Revenue:</span>
    <span class="summary-value">${totalRevenue} NPR</span>
  </div>
  <div class="summary-item">
    <span class="summary-label">Total Expenditure:</span>
    <span class="summary-value">${totalExpenditure} NPR</span>
  </div>
  <div class="summary-item net-collection">
    <span class="summary-label">Net Collection:</span>
    <span class="summary-value">${netCollection} NPR</span>
  </div>
  <div class="collection-breakdown">
    <h4>Type Collections</h4>
    <ul class="type-collections-list">
      <li>X-ray: ${typeCollections.Xray} NPR</li>
      <li>ECG: ${typeCollections.Ecg} NPR</li>
      <li>Lab: ${typeCollections.Lab} NPR</li>
      <li>USG: ${typeCollections.Usg} NPR</li>
      <li>Pharmacy: ${typeCollections.Pharmacy} NPR</li>
      <li>Invoice: ${typeCollections.Invoice} NPR</li>
    </ul>
  </div>
</div>
        `;
          } else {
            alert("No invoices or expenditures found after last deposite.");
          }
        }
      } catch (error) {
        console.error("Error fetching data:", error);
      }
    });
  </script>

</body>
</html>