<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-white shadow-lg rounded-lg p-6">
        
        <!-- Main Menu Buttons -->
        <div class="flex justify-between mb-6">
            <a href="/profile" class="w-1/2 mr-2">
                <button class="w-full bg-gray-800 text-white py-2 rounded hover:bg-gray-900 transition duration-200">
                    Main Menu
                </button>
            </a>
            <a href="/inventory" class="w-1/2 ml-2">
                <button class="w-full bg-gray-800 text-white py-2 rounded hover:bg-gray-900 transition duration-200">
                    Inventory
                </button>
            </a>
        </div>

        <!-- Success & Error Alerts -->
        <% if (successMessage) { %>
            <div id="successAlert" class="bg-green-50 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <strong class="font-semibold">Success!</strong>
                <span class="block sm:inline"><%= successMessage %></span>
            </div>
        <% } %>

        <% if (errorMessage) { %>
            <div id="errorAlert" class="bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <strong class="font-semibold">Failed!</strong>
                <span class="block sm:inline"><%= errorMessage %></span>
            </div>
        <% } %>

        <!-- Create Product Form -->
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Create Product</h3>
        <form action="/createproducts" method="POST" class="space-y-4">
            
            <!-- Barcode Input -->
            <div>
                <label for="productBarcode" class="block text-gray-700 font-semibold mb-1">Scan Barcode</label>
                <input type="text" name="barcode" id="productBarcode" placeholder="Scan or enter barcode" required
                       class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500">
            </div>
            
            
            
            <!-- Product Name -->
            <div class="relative">
                <label for="productNameInput" class="block text-gray-700 font-semibold mb-1">Product Name</label>
                <input type="text" name="name" id="productNameInput" placeholder="Product Name" required
                       class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500">
            </div>

            <!-- Product Price -->
            <div>
                <label for="productPrice" class="block text-gray-700 font-semibold mb-1">Product Price</label>
                <input type="number" name="price" id="productPrice" placeholder="Product Price" required step="0.01"
                       class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500">
            </div>

            <!-- Buy Price -->
            <div>
                <label for="productBuyPrice" class="block text-gray-700 font-semibold mb-1">Buy Price</label>
                <input type="number" name="buyprice" id="productBuyPrice" placeholder="Buy Price" step="0.01"
                       class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500">
            </div>

            <!-- Stock Quantity -->
            <div>
                <label for="productStock" class="block text-gray-700 font-semibold mb-1">Stock Quantity</label>
                <input type="number" name="stock" id="productStock" placeholder="Stock Quantity" required
                       class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500">
            </div>

            <!-- Seller Dropdown -->
            <div>
                <label for="productSeller" class="block text-gray-700 font-semibold mb-1">Select Seller</label>
                <select name="seller" id="productSeller" class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" required>
                    <option value="" disabled selected>Select a seller</option>
                </select>
            </div>

            <div>
                <button type="submit" class="w-full bg-gray-800 text-white py-3 rounded-md hover:bg-gray-900 transition duration-200">
                    Create Product
                </button>
            </div>
        </form>
        
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
                    document.getElementById("productBarcode").focus();
                });
        document.getElementById('productBarcode').addEventListener('change', async function() {
            const barcode = this.value.trim();
            if (barcode.length > 0) {
                const response = await fetch(`/api/products/search?barcode=${encodeURIComponent(barcode)}`);
                const product = await response.json();
                
                if (product) {
                    document.getElementById('productNameInput').value = product.name || '';
                    document.getElementById('productPrice').value = product.price || '';
                    document.getElementById('productBuyPrice').value = product.buyprice || '';
                    document.getElementById('productStock').value = product.quantity || '';

                    const sellerSelect = document.getElementById('productSeller');
                    Array.from(sellerSelect.options).forEach(option => {
                        if (option.value == product.seller) {
                            option.selected = true;
                        }
                    });
                }
            }
        });

        async function fetchSellers() {
            const response = await fetch('/api/parties');
            const sellers = await response.json();
            const sellerSelect = document.getElementById('productSeller');

            sellers.forEach(seller => {
                const option = document.createElement('option');
                option.value = seller.name;
                option.textContent = seller.name;
                sellerSelect.appendChild(option);
            });
        }

        fetchSellers();

        // Auto-hide alerts after 3 seconds
        setTimeout(() => {
            document.getElementById('successAlert')?.remove();
            document.getElementById('errorAlert')?.remove();
        }, 3000);
    </script>
</body>
</html>
