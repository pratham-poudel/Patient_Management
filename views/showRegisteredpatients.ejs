<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registered Patients</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/flatpickr"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f9fafb;
        }
    </style>
</head>
<body class="p-6">

    <div class="max-w-7xl mx-auto">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-bold text-gray-700 mb-4">View Registered Patients</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div>
                    <label for="startDate" class="text-sm font-medium text-gray-700">Start Date</label>
                    <input id="startDate" type="text" class="w-full mt-1 p-2 border rounded shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label for="endDate" class="text-sm font-medium text-gray-700">End Date</label>
                    <input id="endDate" type="text" class="w-full mt-1 p-2 border rounded shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div class="flex items-end">
                    <button id="filterButton" class="w-full bg-indigo-600 text-white py-2 px-4 rounded hover:bg-indigo-700 transition">
                        Filter Patients
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr>
                            <th class="border-b py-4 px-6 font-medium text-gray-600">ID</th>
                            <th class="border-b py-4 px-6 font-medium text-gray-600">Name</th>
                            <th class="border-b py-4 px-6 font-medium text-gray-600">Age</th>
                            <th class="border-b py-4 px-6 font-medium text-gray-600">Remarks</th>
                            <th class="border-b py-4 px-6 font-medium text-gray-600">Date Registered</th>
                        </tr>
                    </thead>
                    <tbody id="patientTable">
                        <!-- Dynamic rows will be injected here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        flatpickr("#startDate", { dateFormat: "Y-m-d" });
        flatpickr("#endDate", { dateFormat: "Y-m-d" });

        const filterButton = document.getElementById("filterButton");
        const patientTable = document.getElementById("patientTable");

        filterButton.addEventListener("click", async () => {
            const startDate = document.getElementById("startDate").value;
            const endDate = document.getElementById("endDate").value;

            if (!startDate || !endDate) {
                alert("Please select both start and end dates.");
                return;
            }

            try {
                // Fetch data from the server
                const response = await fetch(`/showRegisteredpatientsss?start=${startDate}&end=${endDate}`);
                if (!response.ok) {
                    throw new Error("Failed to fetch patient data.");
                }

                const patients = await response.json();

                // Clear existing table rows
                patientTable.innerHTML = "";

                if (patients.length === 0) {
                    patientTable.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center text-gray-500 py-4">No patients found for the selected date range.</td>
                        </tr>
                    `;
                } else {
                    patients.forEach(patient => {
                        patientTable.innerHTML += `
                            <tr>
                                <td class="border-t py-4 px-6">${patient._id}</td>
                                <td class="border-t py-4 px-6">${patient.patientName}</td>
                                <td class="border-t py-4 px-6">${patient.age}</td>
                                <td class="border-t py-4 px-6">${patient.remarks}</td>
                                <td class="border-t py-4 px-6">${new Date(patient.createdAt).toLocaleDateString()}</td>
                            </tr>
                        `;
                    });
                }
            } catch (error) {
                alert("An error occurred: " + error.message);
                console.error(error);
            }
        });
    </script>
</body>
</html>
